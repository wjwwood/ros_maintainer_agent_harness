# syntax=docker/dockerfile:1
# Spike image: Pi + pi-web + pi-mcp-adapter on node:22. Build: docker build -f Dockerfile.spike -t rmah-spike:pi .
# node-pty has no linux prebuilds, so make/g++/python3 are needed at install time.
FROM node:22-bookworm-slim
ARG PI_VERSION=1.1.0
ARG PIWEB_VERSION=1.202610.1
ARG MCP_ADAPTER_VERSION=5.2.0
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ git tini curl jq ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g \
      @earendil-works/pi-coding-agent@${PI_VERSION} \
      @jmfederico/pi-web@${PIWEB_VERSION} \
      pi-mcp-adapter@${MCP_ADAPTER_VERSION}
RUN useradd --uid 1001 --create-home --shell /bin/bash maintainer
USER 1001
WORKDIR /home/maintainer
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["sleep","infinity"]
